{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "प्रतीक फटाके | Pratik Phatake Fireworks",
  "short_name": "प्रतीक फटाके",
  "description": "पुण्यातील अग्रगण्य अधिकृत व सुरक्षित हरित फटाके दालन व्यवस्थापन आणि POS बिलिंग सॉफ्टवेअर (संचालक: श्री. प्रतीक जगताप)",
  "lang": "mr-IN",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#FAF9FF",
  "theme_color": "#5521B5",
  "categories": ["shopping", "business", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "फटाके कॅटलॉग (Catalog)",
      "short_name": "कॅटलॉग",
      "description": "सर्व प्रकारच्या फटाक्यांचा कॅटलॉग पहा",
      "url": "/products?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "काऊंटर POS बिलिंग (POS Billing)",
      "short_name": "POS बिलिंग",
      "description": "काऊंटर बिलिंग टर्मिनल उघडा",
      "url": "/admin/billing?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "अंदाजे बिल पावती (Estimate Cart)",
      "short_name": "माझी पावती",
      "description": "निवडलेल्या फटाक्यांची अंदाजे बिल पावती",
      "url": "/inquiry-cart?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "दिवाळी सण ऑफर्स (Offers)",
      "short_name": "सण ऑफर्स",
      "description": "सध्या सुरू असलेल्या विशेष सवलती व कूपन्स",
      "url": "/offers?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    }
  ]
}
